# Parallax Fix — required runtime config. Copy to `.env` and fill in.
# Read via --allow-env. NEVER commit the filled-in .env (see .gitignore).

# Claude API — enrichment + synthesis (required for Phases 3–4)
ANTHROPIC_API_KEY=

# Reddit — free tier, non-commercial/research only (Phase 2)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=parallax-fix/0.1 (research)

# Bluesky searchPosts — optional. The public AppView search is keyless by default;
# set this only if you have an authenticated session and want its higher rate limits.
BLUESKY_ACCESS_TOKEN=

# X / Twitter — OFF by default, Phase 5 only, pay-per-use. Leave blank to keep disabled.
X_BEARER_TOKEN=

# Corpus storage — Postgres + pgvector (Phase 1). One DB for the event log + vectors.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parallaxfix

# Embeddings — local model via transformers.js. Weights cache under ./models on first run.
# This is the storage-tier embedder: it runs on every ingested item, so it stays free/local.
PARALLAX_FIX_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Voyage AI — optional rerank tier (src/corpus/embed_voyage.ts). Never runs on the full
# corpus, only on a briefing's already-narrow retrieval candidate pool, and each vector is
# cached permanently once computed. Omit to fall back to local-embedding-only relevance.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# App settings
PARALLAX_FIX_DATA_DIR=./data

# Egress (provided by nucklehead host; do not unset/override to bypass TLS)
# HTTPS_PROXY=
# DENO_CERT=
